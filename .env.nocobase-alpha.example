# Use only an official image tag that has been verified before startup.
NOCOBASE_ALPHA_IMAGE="nocobase/nocobase:replace-with-verified-2.4-alpha-tag"

# The alpha instance uses an isolated database and storage volume.
NOCOBASE_ALPHA_DB_ROOT_PASSWORD="replace-with-a-strong-root-password"
NOCOBASE_ALPHA_DB_NAME="nocobase_alpha"
NOCOBASE_ALPHA_DB_USER="nocobase_alpha_user"
NOCOBASE_ALPHA_DB_PASSWORD="replace-with-a-strong-app-password"
NOCOBASE_ALPHA_APP_KEY="replace-with-a-long-random-app-key"

# Configure these secrets in NocoBase or its secret manager, never commit values.
DEEPSEEK_API_KEY="replace-in-runtime-only"
GOOGLE_MAPS_API_KEY="replace-in-runtime-only"
GOOGLE_OAUTH_CLIENT_ID="replace-in-runtime-only"
GOOGLE_OAUTH_CLIENT_SECRET="replace-in-runtime-only"

