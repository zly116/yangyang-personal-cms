# Local Docker MySQL. Use the same values in the connection URLs below.
MYSQL_ROOT_PASSWORD="replace-with-a-local-root-password"
MYSQL_DATABASE="yangyang_cms"
MYSQL_USER="cms_user"
MYSQL_PASSWORD="replace-with-a-local-app-password"

# Prisma connects through the host port mapped by docker-compose.yml.
DATABASE_URL="mysql://cms_user:replace-with-a-local-app-password@localhost:3308/yangyang_cms"
SHADOW_DATABASE_URL="mysql://root:replace-with-a-local-root-password@localhost:3308/yangyang_cms_shadow"

# Used only by the seed command to create the first administrator.
ADMIN_EMAIL="your-email@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
