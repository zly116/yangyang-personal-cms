# Local development database. Copy this file to .env before running Prisma.
DATABASE_URL="mysql://cms_user:cms_password@localhost:3308/yangyang_cms"
SHADOW_DATABASE_URL="mysql://root:local_root_password@localhost:3308/yangyang_cms_shadow"

# Used only by the seed command to create the first administrator.
ADMIN_EMAIL="your-email@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
