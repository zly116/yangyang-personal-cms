# MySQL container initialization. Replace every example secret.
MYSQL_ROOT_PASSWORD="replace-with-a-strong-root-password"
MYSQL_DATABASE="yangyang_cms"
MYSQL_USER="cms_user"
MYSQL_PASSWORD="replace-with-a-strong-app-password"

# The password in DATABASE_URL must be URL-encoded when it contains reserved characters.
DATABASE_URL="mysql://cms_user:replace-with-a-url-encoded-app-password@mysql:3306/yangyang_cms"

# Used by `npm run db:seed` to create or update the administrator.
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-admin-password"

# Obtain this token from Cloudflare Zero Trust after creating a named Tunnel.
CLOUDFLARE_TUNNEL_TOKEN="replace-with-the-cloudflare-tunnel-token"

# Switch to `nocobase` only after collections, permissions and imported data are verified.
CONTENT_SOURCE="prisma"
NOCOBASE_INTERNAL_URL="http://nocobase:80"
NOCOBASE_API_TOKEN="replace-with-a-least-privilege-nocobase-token"
NOCOBASE_PUBLIC_ADMIN_URL="https://cms.example.com/admin"

# NocoBase has an isolated MySQL database.
NOCOBASE_DB_ROOT_PASSWORD="replace-with-a-strong-nocobase-root-password"
NOCOBASE_DB_NAME="nocobase"
NOCOBASE_DB_USER="nocobase_user"
NOCOBASE_DB_PASSWORD="replace-with-a-strong-nocobase-db-password"
NOCOBASE_APP_KEY="replace-with-a-long-random-app-key"

# Server-side public AI Portal. Never expose this key with a NEXT_PUBLIC_ prefix.
DEEPSEEK_API_KEY="replace-with-your-deepseek-api-key"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com/chat/completions"

# Public Portal integrations. Restrict the AMap key to your website domains.
NOCOBASE_CONTACT_COLLECTION="contactMessages"
NOCOBASE_LOCATION_COLLECTION="locations"
AMAP_WEB_KEY="replace-with-your-amap-web-js-key"
AMAP_SECURITY_CODE="replace-with-your-amap-security-code"

